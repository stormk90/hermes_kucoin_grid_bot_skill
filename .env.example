# =====================================================================
# PLANTILLA DE CONFIGURACIÓN SEGURA - GRID BOT & ERP
# Copia este archivo a '.env' y completa con tus credenciales personales.
# NUNCA compartas ni subas tu archivo '.env' real a ningún repositorio.
# =====================================================================

# Credenciales API de KuCoin (Spot Trading)
KUCOIN_API_KEY=tu_api_key_aqui
KUCOIN_API_SECRET=tu_api_secret_aqui
KUCOIN_API_PASSPHRASE=tu_passphrase_aqui

# Par de Trading y Capital Inicial
SYMBOL=BTC/USDT
CAPITAL=00.00

# Parámetros del Grid
GRID_SPACING_PCT=1.35
NUM_GRID_LEVELS=8

# Notificaciones vía Telegram (Opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Puerto del Dashboard ERP Web
PORT=5000
